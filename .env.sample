#APP_SETTINGS
API_PORT=4100
RUN_CRON=yes or no

#AUTHORIZATION
JWT_SECRET=
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 '앱 ID'(숫자). 액세스 토큰이 우리 앱
# 것인지 검증하는 데 쓴다. 없으면 카카오 로그인이 전부 막힌다.
KAKAO_APP_ID=

#AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_CDN=

#REDIS
USE_REDIS=yes or no

#THIRD_PARTY_API_ENDPOINTS
SLACK_COINSECT_API=
SLACK_IMAGE_MODERATION=
COINSECT_CHAT=
WHALE_ALERT=
GOOGLE_AI_STUDIO=

#POSITION_APPROVAL
# yes면 데스크톱 캡처의 판독을 슬랙으로 묻지 않고 바로 반영하고, 결과만 알린다.
# 사람이 스샷을 보고 걸러주는 층이 사라지므로 오인식이 그대로 유저 푸시까지 나간다.
# 판독이 충분히 믿을 만하다고 판단했을 때만 켤 것. 유저 제보에는 적용되지 않는다.
# 값이 없으면 꺼진 것으로 본다.
POSITION_AUTO_APPROVE=yes or no

#CAPTURE_LIMITS
# 사용자가 '지금 캡처'를 눌렀을 때의 제한. 요청자가 아니라 스트리머 단위로 건다
# (trustProxy 때문에 IP를 못 믿는다 - services/content/desktop_jobs.ts 주석 참고).
# 마지막으로 실제 캡처한 지 이 시간이 안 지났으면 막는다. 기본 300초.
CAPTURE_USER_COOLDOWN_SEC=300
# 스트리머가 늘어도 총량이 함께 늘지 않도록 전체에 씌우는 시간당 상한. 기본 30건.
CAPTURE_USER_HOURLY_LIMIT=30

#DESKTOP_CAPTURE
# 가정용 캡처 서비스(capture_desktop)를 식별하는 공유 시크릿.
# 요청자를 coinsect-api-desktop으로 표기하고 데스크톱 제보 레인으로 보내는 기준이 된다.
# capture_desktop/.env 에도 같은 값을 넣는다.
DESKTOP_SECRET=

#FIREBASE
# 웹푸시(FCM)용 서비스 계정 JSON. 한 줄 JSON을 그대로 넣거나 base64로 넣는다.
# 예전에는 services/firebase/fcm_cert.ts 파일만 봤는데, 그 파일은 .gitignore라
# 빌드가 GitHub 러너로 옮겨간 뒤 산출물에서 빠졌고 푸시가 전부 실패했다.
# 이 값이 없으면 fcm_cert.ts로 폴백하고, 그것도 없으면 기동 로그에 에러를 남긴다.
FIREBASE_SERVICE_ACCOUNT=

#MONITORING
# /metrics(Prometheus 스크레이프)를 여는 토큰. 없으면 엔드포인트 자체를 열지 않는다.
# 이 서버는 4100 포트가 인터넷에서 직접 닿아서 nginx로만 막을 수 없다 - 토큰으로 막는다.
# 같은 값을 ~/web/monitoring/prometheus.yml의 authorization.credentials에 넣는다.
METRICS_TOKEN=
