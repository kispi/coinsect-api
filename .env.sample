#APP_SETTINGS
API_PORT=4100
RUN_CRON=yes or no

#AUTHORIZATION
JWT_SECRET=
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 '앱 ID'(숫자). 액세스 토큰이 우리 앱
# 것인지 검증하는 데 쓴다. 없으면 카카오 로그인이 전부 막힌다.
KAKAO_APP_ID=

#AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_CDN=

#REDIS
USE_REDIS=yes or no

#THIRD_PARTY_API_ENDPOINTS
SLACK_COINSECT_API=
SLACK_IMAGE_MODERATION=
COINSECT_CHAT=
WHALE_ALERT=
GOOGLE_AI_STUDIO=

#SLACK_INTERACTIVITY
# 슬랙 앱 > Basic Information > App Credentials > Signing Secret.
# 승인 버튼 클릭 = 전체 푸시 발송이므로, 이 값으로 요청 서명을 검증하지 않으면
# 엔드포인트 주소만 아는 사람이 임의의 포지션을 밀어넣을 수 있다.
SLACK_SIGNING_SECRET=
# 승인/거절 버튼을 누를 수 있는 슬랙 사용자 ID. 쉼표로 구분한다.
# 프로필 > 더 보기 > 멤버 ID 복사로 얻는다.
SLACK_APPROVER_IDS=

#DESKTOP_CAPTURE
# 가정용 캡처 서비스(capture_desktop)가 자신을 증명하는 공유 시크릿.
# capture_desktop/.env 에도 같은 값을 넣는다.
DESKTOP_SECRET=