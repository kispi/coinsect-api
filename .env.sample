#APP_SETTINGS
API_PORT=4100
RUN_CRON=yes or no

#AUTHORIZATION
JWT_SECRET=
# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키의 '앱 ID'(숫자). 액세스 토큰이 우리 앱
# 것인지 검증하는 데 쓴다. 없으면 카카오 로그인이 전부 막힌다.
KAKAO_APP_ID=

#AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_CDN=

#REDIS
USE_REDIS=yes or no

#THIRD_PARTY_API_ENDPOINTS
SLACK_COINSECT_API=
SLACK_IMAGE_MODERATION=
COINSECT_CHAT=
WHALE_ALERT=
GOOGLE_AI_STUDIO=

#DESKTOP_CAPTURE
# 가정용 캡처 서비스(capture_desktop)를 식별하는 공유 시크릿.
# 요청자를 coinsect-api-desktop으로 표기하고 데스크톱 제보 레인으로 보내는 기준이 된다.
# capture_desktop/.env 에도 같은 값을 넣는다.
DESKTOP_SECRET=