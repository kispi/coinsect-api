# 서버 .env의 DESKTOP_SECRET과 같은 값이어야 한다.
API_BASE_URL=https://api.coinsect.io
DESKTOP_SECRET=

# 아래는 전부 선택. 기본값으로 충분하다.
# 방송인이 몰리는 21~3시(KST)만 촘촘히 돌고 나머지는 느슨하게 돈다.
PEAK_FROM_HOUR=21
PEAK_TO_HOUR=3
PEAK_INTERVAL_MS=300000
OFFPEAK_INTERVAL_MS=3600000
FRAMES=3
FRAME_INTERVAL_SEC=4

# yt-dlp가 PATH에 없거나 봇 차단 우회 인자가 필요할 때만.
# winget으로 깔면 PATH에 안 잡히는 경우가 있어 전체 경로를 적어두는 편이 안전하다.
# YT_DLP_PATH=
# FFMPEG_PATH=
# YT_DLP_EXTRA_ARGS=--extractor-args youtube:player_client=tv,android_vr
